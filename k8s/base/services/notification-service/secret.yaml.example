# notification-service 자체 시크릿.
# 현재는 자체 비밀이 없다 (DB/JWT/internal-api/admin 모두 공통 secret 에서 envFrom).
# 향후 FCM 키, 외부 알림 SDK credential 등이 추가되면 여기에 박는다.
apiVersion: v1
kind: Secret
metadata:
  name: notification-service-secret
  namespace: mypoly
type: Opaque
stringData:
  # FCM_PROJECT_ID: ""
  # FCM_PRIVATE_KEY: ""
  # APNS_KEY_ID: ""
  # 현재는 placeholder. 빈 secret 도 envFrom 에서 안전.
  PLACEHOLDER: ""
